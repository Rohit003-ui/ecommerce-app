# --- Server ---
PORT=5000
NODE_ENV=production

# --- AWS RDS MySQL Connection ---
# DB_HOST = your RDS endpoint, e.g. database-1.abcdefghij.us-east-1.rds.amazonaws.com
DB_HOST=database-1.czumw8eq2qw0.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=database-1

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Set this to your EC2 public IP / domain where the frontend is served from
CLIENT_ORIGIN=http://localhost:3000
